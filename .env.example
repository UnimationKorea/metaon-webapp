METAON_API_ORIGIN=https://imetaon.com:5680
METAON_CDN_ORIGIN=https://metaon.s3.ap-northeast-2.amazonaws.com
METAON_APP_IDX=2
METAON_APP_VERSION=2.2.25
METAON_PLATFORM=Android

# MetaOn /book/list currently requires an authenticated Session-Id.
# Provide these only when an authorized account/session is available.
METAON_USER_IDX=0
METAON_SESSION_ID=
METAON_COOKIE=
METAON_AUTH_COOKIE_SECRET=replace-with-a-long-random-secret
METAON_AUTH_COOKIE_SECURE=0

# Dedicated NPC Quick Check viewer. Keep the launch secret in Secret Manager in production.
METAON_NPC_QUICK_CHECK_URL=http://127.0.0.1:5174/?mode=npc-quick-check
METAON_NPC_LAUNCH_SECRET=replace-with-a-separate-long-random-secret
METAON_PUBLIC_ORIGIN=http://127.0.0.1:5173
METAON_NPC_SCENARIO_API_URL=
METAON_NPC_SCENARIO_API_KEY=
METAON_NPC_SCENARIO_TIMEOUT_MS=5000

# Optional local development overrides.
PORT=4100
VITE_DEV_PORT=5173
VITE_BFF_ORIGIN=http://127.0.0.1:4100
